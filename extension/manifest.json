{
  "manifest_version": 3,
  "name": "ReadFlow Clip",
  "version": "0.1.0",
  "description": "把 X/推特 收藏与网页推送到 ReadFlow 桌面客户端（零 API 费用，配套 localhost 通信）",
  "permissions": ["storage", "activeTab", "scripting", "tabs"],
  "host_permissions": [
    "http://127.0.0.1:47832/*",
    "https://x.com/*",
    "https://twitter.com/*",
    "https://*/*"
  ],
  "action": { "default_popup": "popup.html", "default_title": "ReadFlow Clip" },
  "background": { "service_worker": "background.js" },
  "content_scripts": [
    { "matches": ["https://x.com/*", "https://twitter.com/*"], "js": ["content.js"], "run_at": "document_idle" }
  ],
  "icons": {}
}
